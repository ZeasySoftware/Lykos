# Vorlage für /etc/lykos/lykos.env auf dem Docker-Host. deploy.sh erzeugt die Datei samt Secrets beim ersten Lauf.
# Lokal: als deploy/.env kopieren und ausfüllen.
LYKOS_PUBLIC_URL=https://chat.example.org
LYKOS_INSTANCE_NAME=Lykos
# Quellcode der laufenden Fassung (AGPL §13). Bei eigenen Änderungen auf den eigenen Fork zeigen lassen.
#LYKOS_SOURCE_URL=https://git.zeasy.dev/ZeasyAlex/Lykos
# Maximale Größe eines Datei-Uploads in MB (Reverse Proxy muss mindestens so viel durchlassen).
LYKOS_MAX_UPLOAD_MB=100
# Speicher-Kontingent pro Nutzer für Anhänge in MB (0 = unbegrenzt).
LYKOS_USER_QUOTA_MB=2048
# Dateispeicher: local (Volume "files") oder s3 (Garage/MinIO/AWS, siehe README).
LYKOS_STORAGE=local
#LYKOS_S3_ENDPOINT=http://garage:3900
#LYKOS_S3_BUCKET=lykos
#LYKOS_S3_REGION=garage
#LYKOS_S3_ACCESS_KEY_ID=
#LYKOS_S3_SECRET_ACCESS_KEY=
#LYKOS_S3_PATH_STYLE=true
#LYKOS_S3_PREFIX=
# Adresse(n) des Reverse Proxys (IP/CIDR, kommagetrennt) – nur dieser darf X-Forwarded-For setzen.
LYKOS_TRUSTED_PROXIES=
POSTGRES_PASSWORD=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Öffentliche LiveKit-Signalisierung (wss://, Reverse Proxy -> Host:7880). Leer = Voice aus.
LYKOS_LIVEKIT_URL=wss://rtc.chat.example.org
# Desktop-App: Gitea-API der Release-Liste des öffentlichen Release-Repos. Daraus kommen die Download-Seite
# (/download, GET /api/desktop/latest) und das Update-Manifest der Desktop-App (GET /api/desktop/latest.json).
# Verwendet wird das neueste Release (kein Entwurf) mit *-setup.exe (+ .sha256, + .sig für Updates);
# der Server cacht es 10 Minuten. Leer = keine Download-Seite/Updates über diese Instanz.
# Voreinstellung: die offiziellen Lykos-Desktop-Releases.
LYKOS_DESKTOP_RELEASES_URL=https://git.zeasy.dev/api/v1/repos/ZeasyAlex/Lykos-Releases/releases
# Feedback: Instanz-Admins können Meldungen per Klick als Gitea-Issue anlegen (nie automatisch). API-Basis des Repos
# und ein Token mit Schreibrecht auf Issues. Ins Issue kommen Titel, Beschreibung, Meldungsnummer und – falls der
# Melder zugestimmt hat – die technischen Infos, aber kein Nutzername und kein Screenshot. Beide leer = Funktion aus.
#LYKOS_FEEDBACK_GITEA_URL=https://git.example.org/api/v1/repos/<besitzer>/<repo>
#LYKOS_FEEDBACK_GITEA_TOKEN=

# Mailversand (optionale E-Mail-Adresse, „Passwort vergessen“, 2FA per E-Mail). Ohne SMTP sind diese
# Funktionen ausgeblendet. Getrennte Variablen bevorzugen – Sonderzeichen im Passwort brauchen dann kein
# URL-Encoding. LYKOS_SMTP_TLS: implicit (Port 465) | starttls (Port 587) | none (nur lokale Relays).
# Echte Zugangsdaten nur in /etc/lykos/lykos.env, nie ins Repo.
#LYKOS_MAIL_FROM=lykos@example.org
#LYKOS_SMTP_HOST=smtp.example.org
#LYKOS_SMTP_PORT=465
#LYKOS_SMTP_TLS=implicit
#LYKOS_SMTP_USER=lykos@example.org
#LYKOS_SMTP_PASSWORD=
# Alternativ als URL (Sonderzeichen URL-kodieren, z. B. ! → %21): smtps://user:pass@host:465 bzw. smtp://…:587
#LYKOS_SMTP_URL=
# Nur Entwicklung: Mails samt Links/Codes ins Log statt verschicken.
#LYKOS_MAIL=log

# Anmeldung über externe Anbieter (optional). Presets: discord, github, google – nur Client-ID/Secret nötig.
# Redirect-URI beim Anbieter: <LYKOS_PUBLIC_URL>/api/auth/oidc/<name>/callback
#LYKOS_OAUTH_PROVIDERS=discord,github,google
#LYKOS_OAUTH_DISCORD_CLIENT_ID=
#LYKOS_OAUTH_DISCORD_CLIENT_SECRET=
# Mit "identify email" kann die (von Discord bestätigte) Adresse nach Zustimmung übernommen werden.
#LYKOS_OAUTH_DISCORD_SCOPES=identify
#LYKOS_OAUTH_GITHUB_CLIENT_ID=
#LYKOS_OAUTH_GITHUB_CLIENT_SECRET=
#LYKOS_OAUTH_GOOGLE_CLIENT_ID=
#LYKOS_OAUTH_GOOGLE_CLIENT_SECRET=
